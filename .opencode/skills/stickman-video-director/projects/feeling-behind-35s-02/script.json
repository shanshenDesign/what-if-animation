  "lines": [
    {
      "text": "Everyone else's life looks effortless. Yours feels like you're always three steps behind.",
      "caps": ["Everyone else's life", "looks effortless.", "Yours feels like you're", "always three steps behind."]
    },
    {
      "text": "But you're comparing your raw footage to their highlight reel.",
      "caps": ["But you're comparing", "your raw footage", "to their highlight reel."]
    },
    {
      "text": "They edited out the panic, the retries, the 2 AM meltdowns.",
      "caps": ["They edited out the panic,", "the retries,", "the 2 AM meltdowns."]
    },
    {
      "text": "Nobody posts the failed drafts or the fourth attempt.",
      "caps": ["Nobody posts the failed drafts", "or the fourth attempt."]
    },
    {
      "text": "Behind the scenes, everyone is just guessing what they're doing.",
      "caps": ["Behind the scenes,", "everyone is just guessing", "what they're doing."]
    },
    {
      "text": "Your timeline isn't late. It's just unedited.",
      "caps": ["Your timeline isn't late.", "It's just unedited."]
    },
    {
      "text": "So stop refreshing their chapter while you're still writing yours.",
      "caps": ["So stop refreshing their chapter", "while you're still writing yours."]
    },
    {
      "text": "Do the next small thing, today.",
      "caps": ["Do the next small thing,", "today."]
    },
    {
      "text": "Effortless is just effort nobody filmed.",
      "caps": ["Effortless is just effort", "nobody filmed."]
    },
    {
      "text": "Your turn is coming. Keep going.",
      "caps": ["Your turn is coming.", "Keep going."]
    }
