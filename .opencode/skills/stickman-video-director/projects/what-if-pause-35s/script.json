  "lines": [
    {
      "text": "You drop your coffee. Time freezes.",
      "caps": ["You drop your coffee.", "Time freezes."]
    },
    {
      "text": "Ten seconds. The splash just hangs there.",
      "caps": ["Ten seconds.", "The splash just hangs there."]
    },
    {
      "text": "So you don't clean it up. You pose instead.",
      "caps": ["So you don't clean it up.", "You pose instead."]
    },
    {
      "text": "Chin up. One hand on the counter. Flawless.",
      "caps": ["Chin up.", "One hand on the counter.", "Flawless."]
    },
    {
      "text": "Wrong meeting? Freeze. Swap the slides.",
      "caps": ["Wrong meeting?", "Freeze.", "Swap the slides."]
    },
    {
      "text": "Bad haircut? Freeze. Walk out backwards.",
      "caps": ["Bad haircut?", "Freeze.", "Walk out backwards."]
    },
    {
      "text": "Ten seconds is enough to fix almost anything.",
      "caps": ["Ten seconds is enough", "to fix almost anything."]
    },
    {
      "text": "Then the clock clicks, and the world unpauses.",
      "caps": ["Then the clock clicks,", "and the world unpauses."]
    },
    {
      "text": "Coffee lands. Nobody saw a single thing.",
      "caps": ["Coffee lands.", "Nobody saw a single thing."]
    },
    {
      "text": "Except the security camera in the corner.",
      "caps": ["Except the security camera", "in the corner."]
    },
    {
      "text": "That one never freezes. It records everything.",
      "caps": ["That one never freezes.", "It records everything."]
    },
    {
      "text": "At normal speed. For the staff party tonight.",
      "caps": ["At normal speed.", "For the staff party tonight."]
