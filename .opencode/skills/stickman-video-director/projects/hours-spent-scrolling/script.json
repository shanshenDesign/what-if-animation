    {
      "text": "Quick question: how many hours did you spend scrolling today?",
      "caps": ["Quick question:", "how many hours did you spend scrolling today?"]
    },
    {
      "text": "Don't look away — I can see you through this screen.",
      "caps": ["Don't look away —", "I can see you through this screen."]
    },
    {
      "text": "Up, up, down. Your thumb knows the rhythm better than you do.",
      "caps": ["Up, up, down.", "Your thumb knows the rhythm", "better than you do."]
    },
    {
      "text": "One hour. Three hours. Five plus, and the counter just keeps glowing.",
      "caps": ["One hour. Three hours.", "Five plus,", "and the counter just keeps glowing."]
    },
    {
      "text": "The room goes dark, but that cyan light stays stuck on your face.",
      "caps": ["The room goes dark,", "but that cyan light", "stays stuck on your face."]
    },
    {
      "text": "So tell me — what do you actually remember from the last hour?",
      "caps": ["So tell me —", "what do you actually remember", "from the last hour?"]
    },
    {
      "text": "Nothing? Thought so.",
      "caps": ["Nothing? Thought so."]
    },
    {
      "text": "The switch is right here, glowing amber, waiting for your hand.",
      "caps": ["The switch is right here,", "glowing amber,", "waiting for your hand."]
    },
    {
      "text": "Swipe it off. I'll be here when you come back.",
      "caps": ["Swipe it off.", "I'll be here when you come back."]
